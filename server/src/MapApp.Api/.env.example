# Copy this file to .env (same folder, gitignored) and fill in your values.
# Keys use ASP.NET Core's "Section__Key" form and override appsettings.json.
# Real environment variables with the same names take precedence over this file.

# Required: your MongoDB connection string (e.g. the Docker container's port and credentials).
MongoDb__ConnectionString=mongodb://<user>:<password>@localhost:27017

# Optional: defaults to "MapAppDb" from appsettings.json.
# MongoDb__DatabaseName=MapAppDb
